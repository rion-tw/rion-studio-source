{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "electron-builder.config.mjs",
    "e2e/desktop/wdio.electron.conf.ts",
    "src/electron/e2e/index.ts",
    "src/electron/e2e/preload.ts",
    "src/renderer/src/main.tsx",
    // Independent module script loaded by src/renderer/index.html before React.
    "src/renderer/src/app/earlyDocumentState.ts",
    "src/shared/browser-overlay/*.js",
    "e2e/desktop/specs/*.e2e.ts",
    "scripts/*.mjs",
    "scripts/migrationDiagnostics/helperEntry.ts",
    "tests/**/*.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx,js}",
    "e2e/**/*.ts",
    "scripts/*.{mjs,mts}",
    "scripts/migrationDiagnostics/*.{mjs,ts}",
    "tests/**/*.{ts,tsx}",
    "*.{ts,mjs}"
  ],
  "ignore": [
    "scripts/*.d.mts",
    "src/renderer/src/global.d.ts",
    "src/shared/generated/**",
    // Raw runtime fragments are native Rust include_str! inputs and are not standalone JavaScript modules.
    "src/shared/browser-overlay/macro-overlay-runtime/*.js"
  ],
  "ignoreDependencies": [
    // Executed through pnpm solely for updater signing.
    "@tauri-apps/cli",
    // WDIO loads these CLI/config-selected packages without static imports.
    "@wdio/cli",
    // Electron WebdriverIO loads the service from the profile configuration.
    "@wdio/electron-service",
    "@wdio/local-runner",
    "@wdio/mocha-framework",
    "@wdio/spec-reporter",
    // Loaded from CSS through @import, outside Knip's JavaScript dependency graph.
    "tailwindcss"
  ],
  "ignoreIssues": {
    // GitHub-hosted runners provide jq; it is not an npm dependency.
    ".github/workflows/electron-production-provisional-recovery.yml": [
      "binaries"
    ]
  },
  "ignoreUnresolved": [
    // macOS provides this absolute OS executable; Windows cannot resolve it.
    "/bin/ps"
  ],
  "rules": {
    // Knip 6 reports the existing intentional exports and shared types as warnings.
    "exports": "warn",
    "types": "warn"
  }
}
