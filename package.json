{
  "name": "rion-studio",
  "version": "0.0.0-development",
  "description": "A desktop browser role launcher and automation host.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/devTauri.mjs",
    "dev:renderer": "vite --config vite.tauri.config.ts",
    "build": "pnpm run typecheck && pnpm run build:renderer && cargo build -p rion-tauri",
    "build:renderer": "vite build --config vite.tauri.config.ts",
    "build:e2e:desktop": "node scripts/buildDesktopE2e.mjs",
    "package": "node scripts/packageTauri.mjs",
    "dist": "node scripts/buildTauriRelease.mjs",
    "release:manifest": "node scripts/createTauriUpdaterManifest.mjs",
    "release:plan": "node scripts/planSemanticRelease.mjs",
    "release:version": "node scripts/applyReleaseVersion.mjs",
    "verify:system-only": "node scripts/verifySystemOnlyProduct.mjs",
    "check:source-hygiene": "node scripts/checkSourceHygiene.mjs",
    "check:source-hygiene:report": "node scripts/checkSourceHygiene.mjs --report",
    "check:cargo-dependencies": "node scripts/checkCargoDependencies.mjs",
    "check:release-size": "node scripts/checkReleaseSize.mjs",
    "check:desktop-e2e-isolation": "node scripts/verifyDesktopE2eIsolation.mjs",
    "check:unused": "knip",
    "check:hygiene": "pnpm run check:source-hygiene && pnpm run check:unused && pnpm run check:cargo-dependencies",
    "test:rust": "cargo test --workspace --all-targets",
    "test:rust:portable": "cargo test -p rion-core -p rion-platform --all-targets",
    "test:e2e:desktop": "node scripts/runDesktopE2e.mjs",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --no-deps -- -D warnings",
    "lint:rust:portable": "cargo fmt --all -- --check && cargo clippy -p rion-core -p rion-platform --all-targets --no-deps -- -D warnings",
    "generate:rust-types": "cargo test -p rion-core export_bindings",
    "performance:measure": "node scripts/benchmarkProcessTree.mjs",
    "performance:aggregate": "node scripts/aggregatePerformanceRuns.mjs",
    "performance:fixture": "node scripts/performanceFixtureServer.mjs",
    "runtime-authority:fixture": "node scripts/runtimeAuthorityFixtureServer.mjs",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "test": "vitest run",
    "release": "semantic-release"
  },
  "keywords": [
    "tauri",
    "browser-role",
    "launcher"
  ],
  "author": "Rion Studio",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24.10.0"
  },
  "packageManager": "pnpm@11.13.0",
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@dagrejs/dagre": "^3.1.1",
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@semantic-release/exec": "^7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/mocha": "10.0.10",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sortablejs": "^1.15.9",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@wdio/cli": "9.30.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "knip": "^6.31.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "semantic-release": "^25.0.8",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "webdriverio": "9.30.1"
  }
}
