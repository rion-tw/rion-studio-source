{
  "name": "rion-studio",
  "version": "0.0.0-development",
  "description": "A desktop browser role launcher and automation host.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/devTauri.mjs",
    "dev:degraded": "node scripts/devTauri.mjs --degraded",
    "dev:renderer": "vite --config vite.tauri.config.ts",
    "build": "pnpm run typecheck && pnpm run build:renderer && cargo build -p rion-tauri",
    "build:renderer": "vite build --config vite.tauri.config.ts",
    "package": "node scripts/packageTauri.mjs",
    "dist": "node scripts/buildTauriRelease.mjs",
    "release:manifest": "node scripts/createTauriUpdaterManifest.mjs",
    "release:version": "node scripts/applyReleaseVersion.mjs",
    "verify:system-only": "node scripts/verifySystemOnlyProduct.mjs && node scripts/verifyTauriParityLedger.mjs",
    "verify:parity-ledger": "node scripts/verifyTauriParityLedger.mjs",
    "verify:parity-ledger:write": "node scripts/verifyTauriParityLedger.mjs --write-report",
    "test:rust": "cargo test --workspace --all-targets",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "generate:rust-types": "cargo test -p rion-core export_bindings",
    "performance:measure": "node scripts/benchmarkProcessTree.mjs",
    "performance:aggregate": "node scripts/aggregatePerformanceRuns.mjs",
    "performance:fixture": "node scripts/performanceFixtureServer.mjs",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "test": "vitest run",
    "test:native:system-input": "node scripts/verifySystemTrustedInput.mjs",
    "test:native:runtime-restore": "node scripts/verifySystemRuntimeRestore.mjs",
    "test:native:file-operations": "node scripts/verifySystemFileOperations.mjs",
    "release": "semantic-release"
  },
  "keywords": [
    "tauri",
    "browser-role",
    "launcher"
  ],
  "author": "Rion Studio",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24.10.0"
  },
  "packageManager": "pnpm@11.13.0",
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@semantic-release/exec": "^7.1.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0",
    "semantic-release": "^25.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
