{
  "name": "rion-studio",
  "version": "0.0.0-development",
  "description": "A desktop browser role launcher and automation host.",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "test": "vitest run",
    "package": "pnpm run build && electron-builder --config electron-builder.config.mjs --dir",
    "dist": "pnpm run build && electron-builder --config electron-builder.config.mjs",
    "release": "semantic-release"
  },
  "keywords": [
    "electron",
    "browser-role",
    "launcher",
    "playwright"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24.10.0"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "playwright-core": "^1.50.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.1",
    "@eslint/js": "^9.18.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@semantic-release/exec": "^7.1.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.2.0",
    "semantic-release": "^25.0.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
