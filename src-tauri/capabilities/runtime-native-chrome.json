{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "runtime-native-chrome-local-only",
  "description": "Allows only bundled runtime tab and divider chrome to call their bounded Tauri commands.",
  "local": true,
  "webviews": ["game-tabs-chrome-*", "game-divider-*"],
  "permissions": [
    "allow-rion-divider-pointer",
    "allow-rion-runtime-tab-action"
  ]
}
