{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "system-role-overlay-remote",
  "description": "Allows game role WebViews to call only role-bound macro overlay and audio-state endpoints.",
  "remote": {
    "urls": ["http://*", "https://*"]
  },
  "local": false,
  "webviews": ["game-role-*"],
  "permissions": ["allow-rion-overlay-request", "allow-rion-runtime-audio-state"]
}
