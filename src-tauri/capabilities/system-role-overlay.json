{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "system-role-overlay-remote",
  "description": "Allows game role WebViews to call only role-bound font, overlay, input-cleanup, and audio-state endpoints.",
  "remote": {
    "urls": ["http://*", "http://*:*", "https://*", "https://*:*"]
  },
  "local": false,
  "webviews": ["game-role-*"],
  "permissions": ["allow-rion-browser-font-payload", "allow-rion-macro-key-event-observed", "allow-rion-managed-shortcut-key-phase", "allow-rion-physical-key-cleanup", "allow-rion-overlay-request", "allow-rion-runtime-audio-state"]
}
