{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rion Studio",
  "version": "0.1.0",
  "identifier": "com.rionstudio.launcher",
  "build": {
    "beforeDevCommand": "pnpm run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm run build:renderer",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Rion Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "visible": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "../build/icon.png",
      "../build/icon.icns",
      "../build/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
