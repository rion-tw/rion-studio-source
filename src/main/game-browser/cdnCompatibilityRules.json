{
  "version": 1,
  "rules": [
    {
      "id": "google-hosted-libraries",
      "regexFilter": "^https://ajax\\.googleapis\\.com/(.*)$",
      "regexSubstitution": "https://ajax.loli.net/\\1",
      "sourceHost": "ajax.googleapis.com"
    },
    {
      "id": "google-fonts-css",
      "regexFilter": "^https://fonts\\.googleapis\\.com/(.*)$",
      "regexSubstitution": "https://fonts.googleapis.cn/\\1",
      "sourceHost": "fonts.googleapis.com"
    },
    {
      "id": "google-font-themes",
      "regexFilter": "^https://themes\\.googleusercontent\\.com/(.*)$",
      "regexSubstitution": "https://themes.loli.net/\\1",
      "sourceHost": "themes.googleusercontent.com"
    },
    {
      "id": "google-font-files",
      "regexFilter": "^https://fonts\\.gstatic\\.com/(.*)$",
      "regexSubstitution": "https://fonts.googleapis.cn/\\1",
      "sourceHost": "fonts.gstatic.com"
    },
    {
      "id": "google-recaptcha",
      "regexFilter": "^https://www\\.google\\.com/recaptcha/(.*)$",
      "regexSubstitution": "https://www.recaptcha.net/recaptcha/\\1",
      "sourceHost": "www.google.com"
    },
    {
      "id": "gravatar",
      "regexFilter": "^https://secure\\.gravatar\\.com/(.*)$",
      "regexSubstitution": "https://gravatar.loli.net/\\1",
      "sourceHost": "secure.gravatar.com"
    },
    {
      "id": "bootstrap",
      "regexFilter": "^https://maxcdn\\.bootstrapcdn\\.com/bootstrap/(.*)$",
      "regexSubstitution": "https://lib.baomitu.com/twitter-bootstrap/\\1",
      "sourceHost": "maxcdn.bootstrapcdn.com"
    },
    {
      "id": "jquery",
      "regexFilter": "^https://code\\.jquery\\.com/jquery-([0-9]+\\.[0-9]+(\\.[0-9]+)?(\\.[0-9]+)?)(\\.min)?\\.js(\\?.*)?$",
      "regexSubstitution": "https://fastly.jsdelivr.net/npm/jquery@\\1/dist/jquery\\4.js\\5",
      "sourceHost": "code.jquery.com"
    }
  ]
}
