{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node", "electron", "vitest"]
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/renderer/src/app/copyName.ts",
    "src/renderer/src/app/editorFormState.ts",
    "src/renderer/src/app/editorNavigation.ts",
    "src/renderer/src/app/editorTitle.ts",
    "src/renderer/src/app/launchUrlSelection.ts",
    "src/renderer/src/app/operationState.ts",
    "src/renderer/src/app/roleDefaults.ts",
    "src/renderer/src/app/statusUtils.ts",
    "src/renderer/src/app/rendererReady.ts",
    "src/renderer/src/app/reorderItems.ts",
    "src/renderer/src/app/roleCoverPlaceholder.ts",
    "src/renderer/src/app/types.ts",
    "src/renderer/src/features/dashboard/dashboardUtils.ts",
    "src/renderer/src/features/macros/macroListUtils.ts",
    "src/renderer/src/features/macros/macroUtils.ts",
    "src/renderer/src/features/legal/legalMarkdownParser.ts",
    "src/renderer/src/features/settings/graphicsRestart.ts",
    "src/renderer/src/features/settings/portableSelection.ts",
    "src/renderer/src/features/settings/settingsNavigation.ts",
    "src/renderer/src/features/workspaces/workspaceLayoutUtils.ts",
    "src/renderer/src/features/workspaces/workspaceDisplayUtils.ts",
    "src/renderer/src/features/workspaces/workspaceLaunchUtils.ts",
    "src/renderer/src/i18n.ts",
    "src/shared/**/*.ts",
    "tests/**/*.ts"
  ]
}
