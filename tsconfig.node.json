{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node", "vite/client", "vitest"]
  },
  "include": [
    "e2e/desktop/support/platform.ts",
    "e2e/desktop/support/chromium-escape-key.ts",
    "e2e/desktop/support/windows-runtime-tab-close.ts",
    "e2e/desktop/support/windows-runtime-foreground.ts",
    "e2e/desktop/support/windows-native-edit.ts",
    "e2e/desktop/phaseSpecs.ts",
    "e2e/desktop/support/flyff-caret.ts",
    "e2e/desktop/support/transcript.ts",
    "e2e/desktop/support/window-target.ts",
    "vitest.config.ts",
    "src/electron/**/*.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
